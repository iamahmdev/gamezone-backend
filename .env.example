PORT=5000

# ── REQUIRED: must be set in production ──────────────────────────────────────
# Strong random string, min 32 chars (e.g. openssl rand -hex 32)
JWT_SECRET=apna_strong_secret_yahan_likho_minimum_32_chars

# Admin Panel secret key — used only once to bootstrap the first admin account
# Keep this private! (e.g. openssl rand -hex 16)
ADMIN_SECRET_KEY=apna_admin_secret_key_yahan

# MongoDB Atlas URI
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://gamezone_user:YOUR_PASSWORD@gamezone.xxxxx.mongodb.net/gamezone?retryWrites=true&w=majority

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins
FRONTEND_URL=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Admin WhatsApp for deposit/withdrawal notifications
ADMIN_WHATSAPP=923359348844
